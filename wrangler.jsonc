// Cloudflare Workers deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelf-planner",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
  },
  // Private until 1.0: Cloudflare Access ("Shelf Planner" application) guards this address.
  "workers_dev": true,
  "preview_urls": false,
}
